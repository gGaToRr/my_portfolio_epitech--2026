# ==============================================================================
# Frontend — à copier en portfolio-v1.2.0/portfo/.env.local (jamais commité)
# ==============================================================================
#
# L'envoi des messages de contact passe désormais par le backend FastAPI :
# server.js relaie /api/* vers lui, la configuration SMTP se fait donc
# uniquement côté backend (voir backend.env.example).

# Port d'écoute de server.js en production
API_PORT=5001

# Cible du relais /api/* (nom du service Docker Compose, ou 127.0.0.1 en local)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5001

# --- Repli Web3Forms (optionnel) ---
# Cette clé finit dans le bundle JavaScript, donc publique par conception —
# mais elle est liée à ton adresse et peut servir à inonder ta boîte.
# Ne jamais commiter une vraie clé : la précédente était dans ce fichier et
# reste dans l'historique git, elle doit être révoquée sur web3forms.com.
REACT_APP_WEB3FORMS_KEY=ta_cle_web3forms_ici
