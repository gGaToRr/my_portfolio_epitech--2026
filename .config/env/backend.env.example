# ==============================================================================
# Backend FastAPI — à copier en backend/.env.local (jamais commité)
# ==============================================================================

API_PORT=5001
HOST=0.0.0.0
DEBUG=False

# --- Sécurité & Admin ---
#
# SECRET_KEY et ADMIN_PASSWORD peuvent rester vides ou absents : le serveur
# génère alors lui-même des valeurs aléatoires au premier démarrage, et les
# conserve dans backend/data/ (secret_key et admin_credentials.json, en 0600).
#
# Le mot de passe généré est affiché à chaque démarrage sur la sortie standard,
# donc lisible avec :
#     docker compose logs backend | grep -A5 "COMPTE ADMINISTRATEUR"
#
# Il n'apparaît jamais dans les fichiers .log, qui sont servis par la console
# d'administration et repris dans les archives mensuelles.
#
# Renseigner ces variables ci-dessous désactive complètement la génération.
ADMIN_USERNAME=admin
# SECRET_KEY=
# ADMIN_PASSWORD=

# Nombre de proxys de confiance devant le backend (voir app/security.py).
#   0 = accès direct, en développement : X-Forwarded-For est ignoré.
#   2 = déploiement Docker Compose : nginx, puis le relais /api de server.js.
# Une valeur trop élevée ferait retenir une IP que le visiteur peut inventer,
# ce qui neutraliserait les protections anti-brute-force.
TRUSTED_PROXY_HOPS=0

# Documentation OpenAPI (/docs et /redoc). Fermée par défaut : elle publie
# l'intégralité du schéma, routes admin comprises.
ENABLE_DOCS=False

# --- Rotation des logs ---
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- CORS (séparés par des virgules) ---
# Les origines localhost ne sont ajoutées automatiquement que si DEBUG=True.
CORS_ORIGINS=https://mon-domaine.fr

# --- Contact & SMTP (optionnel) ---
CONTACT_RECEIVER_EMAIL=pierre.untersinger2@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton_adresse@gmail.com
SMTP_PASS=ton_mot_de_passe_application
SMTP_FROM="Pierre Portfolio" <ton_adresse@gmail.com>
SMTP_SECURE=False
