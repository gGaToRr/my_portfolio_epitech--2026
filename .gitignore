# Les dossiers data/ et logs/ doivent exister apres un clone : sans eux, Docker
# cree les points de montage en root et le conteneur, qui tourne sans
# privileges, ne peut plus y ecrire. On garde donc les .gitkeep.
!backend/data/.gitkeep
!backend/logs/.gitkeep
!backend/logs/archives/.gitkeep
*.db
*.sqlite3
.pytest_cache/
.coverage
htmlcov/
.env
